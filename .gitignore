# KiCad auto-save / backup archives (regenerated by KiCad on every save)
**/*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.kicad_pcb
*-save.kicad_sch
_autosave-*

# KiCad local footprint/symbol cache (machine-specific, safe to regenerate)
fp-info-cache
fp-lib-table.lck

# KiCad lock files
*.lck

# Plotted/generated outputs that are cheap to regenerate from source
# (gerbers themselves ARE tracked under manufacturing/, but transient
#  export scratch files are not)
*.bak
*.000

# OS cruft
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
*.swp
